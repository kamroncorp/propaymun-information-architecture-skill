{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kamroncorp/propaymun-information-architecture-skill/blob/main/assets/semantic-ia.schema.json",
  "title": "ProPaymun Semantic Information Architecture",
  "type": "object",
  "required": ["meta", "nodes", "relationships"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "version", "status", "language", "direction", "scope"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 2},
        "direction": {"enum": ["ltr", "rtl"]},
        "scope": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "contexts": {"type": "array"},
    "audiences": {"type": "array"},
    "tasks": {"type": "array"},
    "information_domains": {"type": "array"},
    "objects": {"type": "array"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "type", "parent_id", "evidence_status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "parent_id": {"type": ["string", "null"]},
          "purpose": {"type": "string"},
          "summary": {"type": "string"},
          "order": {"type": "integer"},
          "findability": {"type": "array"},
          "evidence_status": {
            "enum": ["Provided", "Observed", "Confirmed", "Inferred", "Proposed", "Unknown"]
          }
        },
        "additionalProperties": true
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "type", "evidence_status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "label": {"type": "string"},
          "meaning": {"type": "string"},
          "direction": {"enum": ["directed", "bidirectional", "undirected"]},
          "evidence_status": {
            "enum": ["Provided", "Observed", "Confirmed", "Inferred", "Proposed", "Unknown"]
          }
        },
        "additionalProperties": true
      }
    },
    "organization_schemes": {"type": "array"},
    "taxonomy": {"type": "object"},
    "labels": {"type": "array"},
    "metadata_model": {"type": "array"},
    "navigation_systems": {"type": "array"},
    "search": {"type": "object"},
    "permissions": {"type": "array"},
    "governance": {"type": "object"},
    "evidence_ledger": {"type": "array"},
    "assumptions": {"type": "array"},
    "unknowns": {"type": "array"},
    "decisions": {"type": "array"},
    "validation": {"type": "array"}
  },
  "additionalProperties": true
}
